# Alloy blending - Version 1
# Everything written out explicitly, no sets or params
 
from amplpy import AMPL
 
ampl = AMPL()
 
# model
ampl.eval("""
var x1>=0;
var x2>=0;
var x3>=0;
var x4>=0;
var x5>=0;
 
minimize CostPerPound: 22*x1 + 20*x2+ 25*x3 + 24*x4 + 27*x5;
 
subject to Tin: 60*x1 + 25*x2 + 45*x3 + 20*x4 + 50*x5 = 40;
subject to Zinc: 10*x1 + 15*x2 + 45*x3 + 50*x4 + 40*x5 = 35;
subject to Lead: 30*x1 + 60*x2 + 10*x3 + 30*x4 + 10*x5 = 25;
subject to Technology: x1 + x2 + x3 + x4 + x5 = 1;
""")
 
# solve
ampl.option["solver"] = "highs"
ampl.solve()
 
# print results
print("\nBlend:")
for v in ["x1", "x2", "x3", "x4", "x5"]:
    print(f"  {v} = {ampl.get_variable(v).value():.4f}")
 
print(f"\nCost per pound: {ampl.get_objective('CostPerPound').value():.4f}")
